  "notice": "All values are invented placeholders for offline review. They are not production facts, proposed limits, prices or approvals. Map each scenario onto the accepted implementation's actual seams; a scenario the implementation cannot express is a review finding.",
  "vocabulary": {
    "clauses": ["AC-01", "AC-02", "AC-03", "AC-04", "AC-05", "AC-06", "AC-07", "AC-08", "AC-09", "AC-10", "AC-11", "AC-12", "AC-13"],
    "phases": ["P0", "P1", "P2"],
    "stages": ["PARENT_INVOKE", "ROUTE", "INDEX_READ", "DESERIALIZE", "EMBED", "SEARCH", "GENERATE", "SUMMARIZE", "EVIDENCE_PUBLISH"],
    "outcomes": {
      "STOP_BEFORE_DISPATCH": "Stopped in P0; no outbound call of any kind was made.",
      "STOP_AT_STAGE": "A P1 gate stopped the run at stop_at; nothing after it may be sent.",
      "FAIL_ACCEPTANCE_RECORD_ONLY": "All calls already happened; P2 observation fails acceptance. Record it; nothing is resent.",
      "NOT_RAG_SUCCESS_RECORD_ONLY": "Valid HTTP outcome that is not genuine RAG success under AC-09. Record it; not a pass.",
      "EVIDENCE_INTERRUPTED": "Evidence could not be completed or confirmed; never reported as complete; no rerun.",
      "PASS_STRUCTURAL": "Structural and numeric acceptance only (AC-09), subject to AC-11 claim limits."
    },
    "accounting": {
      "NO_DISPATCH": "Not sent; reservation released or never taken.",
      "SETTLE_ACTUAL": "Valid non-negative integer usage within bounds; settle at the bound rate.",
      "RETAIN_FULL_RESERVATION": "Outcome or usage unknown or invalid; full reservation stays charged as potentially billed.",
      "RECORD_UNCLAMPED_OVERRUN": "Usage exceeded a cap or reservation; record actual values unclamped and latch abort."
    },
    "prohibited": ["PARENT_INVOKE", "ROUTE", "INDEX_READ", "DESERIALIZE", "EMBED", "SEARCH", "GENERATE", "SUMMARIZE", "RETRY", "REPLACEMENT_REQUEST", "RERUN", "ALTERNATE_SNAPSHOT", "INDEX_REBUILD", "REPAIR_INPUT", "PROMPT_TUNING", "CHANGE_K_OR_QUERY", "MEMORY_OR_TIMEOUT_INCREASE", "CLAMP_USAGE", "REPORT_COMPLETE"],
    "claims": ["COMPLETE", "RAG_SUCCESS", "ANSWER_CORRECT", "CITATIONS_VALIDATED", "SEMANTIC_ALIGNMENT", "QUALITY_QUALIFIED", "JEV_READY", "RELEASE_PERMITTED", "REQUEST_CANCELLED", "NOT_BILLED", "MEMORY_SUFFICIENT"]
  },
