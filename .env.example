AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
JUDGE_MODEL_ID=us.anthropic.claude-sonnet-4-6
S3_BUCKET_NAME=your-s3-bucket-name
FAISS_INDEX_S3_KEY=index/financial_index.faiss
FAISS_META_S3_KEY=index/financial_meta.json

# Optional
# Default stays Haiku. Jev requires an injected MockTransport; shadow is disabled.
COPILOT_ROUTER_PROVIDER=haiku
# Custom CloudWatch request log (/financial-copilot/requests). Default: true
COPILOT_CW_REQUEST_LOG=true
# /evaluate returns 404 unless this is true AND EVALUATE_ENDPOINT_TOKEN is set
ENABLE_EVALUATE_ENDPOINT=false
# Secret: set only in the deployment environment; never commit a real value
EVALUATE_ENDPOINT_TOKEN=
EVAL_RESULTS_PATH=eval/results/latest.json
EVAL_SLEEP_SECONDS=2
